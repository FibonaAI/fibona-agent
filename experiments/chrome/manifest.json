{
  "manifest_version": 3,
  "name": "Fibona",
  "version": "0.1.0",
  "description": "Fibona Agent in Chrome",
  "homepage_url": "https://fibona.ai",
  "minimum_chrome_version": "135",
  "permissions": [
    "tabs", "activeTab", "tabGroups", "storage", "unlimitedStorage", "debugger", "userScripts", "scripting",
    "sidePanel", "contextMenus", "notifications", "alarms", "bookmarks", "history", "downloads",
    "offscreen", "clipboardRead", "clipboardWrite", "cookies", "webNavigation", "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "omnibox": { "keyword": "fibona" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+Y" } },
    "fibona-command": { "description": "Custom Fibona shortcut (opens Console until customized)" }
  },
  "icons": { "16": "icons/fibona-16.png", "32": "icons/fibona-32.png", "48": "icons/fibona-48.png", "128": "icons/fibona-128.png" },
  "action": {
    "default_title": "Open Fibona",
    "default_icon": { "16": "icons/fibona-16.png", "32": "icons/fibona-32.png", "48": "icons/fibona-48.png", "128": "icons/fibona-128.png" }
  },
  "side_panel": { "default_path": "index.html?surface=sidepanel" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals allow-downloads; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: http: blob: data:; child-src 'self' https: http: blob: data:;"
  },
  "sandbox": { "pages": ["runtime/session.html"] }
}
